<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextH1">
        <item name="android:textSize">27sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextH2">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextH3">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="TextSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="TextLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Badge">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">9dp</item>
        <item name="android:paddingVertical">5dp</item>
    </style>

    <style name="CardStyle" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="IconButton">
        <item name="android:background">@drawable/bg_iconbtn</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">13dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="backgroundTint">@color/surface2</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="DangerButton" parent="PrimaryButton">
        <item name="backgroundTint">@color/red</item>
    </style>

    <style name="InputStyle">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">13dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <style name="SettingRow">
        <item name="android:background">@drawable/bg_setting</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">15dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
